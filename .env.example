# Backend server
API_IP=0.0.0.0
API_PORT=3001

# LLM
LLAMA_ENDPOINT=http://your-llm-server:8888/v1
THINKER_MODEL=your-thinker-model
REFLEX_MODEL=your-reflex-model
LLM_TIMEOUT=600

# MongoDB
MONGODB_URI=mongodb://your-mongo-server:27017
MONGODB_DB=QAssistantChatHistory

# JWT
JWT_SECRET=change-me-to-a-secure-random-string

# Honcho memory
HONCHO_API_KEY=your-honcho-api-key
HONCHO_API_URL=http://your-honcho-server:8000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend (Vite exposes VITE_* vars to browser)
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# ElevenLabs TTS (fallback when no DB provider configured)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_DEFAULT_VOICE=7p1Ofvcwsv7UBPoFNcpI
